<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Xacro Properties ==================== -->
  <!-- Dimensions matching .course-kit/v1/models/course_ackermann/model.sdf -->
  <xacro:property name="wheelbase" value="0.8"/>
  <xacro:property name="track_width" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_length" value="0.07"/>

  <!-- Body parameters -->
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_elevation" value="0.12"/>
  <xacro:property name="body_mass" value="12.0"/>

  <!-- Sensor positions relative to base_link -->
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_y" value="0.0"/>
  <xacro:property name="sensor_z" value="0.38"/>

  <!-- Knuckle & Wheel masses -->
  <xacro:property name="knuckle_mass" value="0.2"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="sensor_mass" value="0.033333333333"/>

  <!-- Materials -->
  <material name="body_blue">
    <color rgba="0.05 0.36 0.72 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>

  <material name="sensor_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ==================== base_link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.55" ixy="0.0" ixz="0.0" iyy="1.10" iyz="0.0" izz="1.40"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Sensors ==================== -->
  <!-- Camera -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${sensor_mass}"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${sensor_mass}"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${sensor_mass}"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Front Steering Knuckles ==================== -->
  <!-- Front Left Knuckle -->
  <link name="front_left_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${knuckle_mass}"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="${wheelbase / 2.0} ${track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25.0" velocity="1.0"/>
  </joint>

  <!-- Front Right Knuckle -->
  <link name="front_right_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${knuckle_mass}"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="${wheelbase / 2.0} -${track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25.0" velocity="1.0"/>
  </joint>

  <!-- ==================== Wheels Macro ==================== -->
  <xacro:macro name="wheel" params="prefix">
    <link name="${prefix}_wheel">
      <inertial>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.006"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Front Wheels (attached to knuckles) -->
  <xacro:wheel prefix="front_left"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel prefix="front_right"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Wheels (attached directly to base_link) -->
  <xacro:wheel prefix="rear_left"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-${wheelbase / 2.0} ${track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel prefix="rear_right"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-${wheelbase / 2.0} -${track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
